# Zak Security - local environment
# Copy to .env and adjust if needed.
# NOTE: .env is gitignored. Never commit tokens or credentials.

# Local SQLite database. No PostgreSQL / Docker required for the prototype.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# Optional. Zak Security runs fully without any of these.
# ------------------------------------------------------------------

# Enables AI-assisted remediation on top of the built-in rule templates.
OPENAI_API_KEY=

# Optional. Used for authenticated GitHub advisory lookups later.
GITHUB_TOKEN=
